# Database Configuration
# Local Development: localhost:3306 / employee_db
# Cloud Hosted MySQL (Aiven, TiDB Cloud, AWS RDS, etc.):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=employee_db

# Alternative Unified Connection URI (Supported on Render / Railway / Aiven):
# If you prefer a single variable, you can provide DATABASE_URL instead of the individual DB_* variables:
# DATABASE_URL=mysql://avnadmin:your_password@mysql-xxxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# SSL/TLS Configuration for Cloud Hosted Databases (Aiven, AWS RDS, TiDB)
# Set DB_SSL_CA to the path of your CA certificate (e.g., /etc/secrets/ca.pem) if CA certificate verification is required
# DB_SSL_CA=/path/to/ca.pem
# Set to true only if connecting to an insecure local database without TLS
DB_SSL_DISABLED=false


# Flask Application Settings
# In production, SECRET_KEY must be a strong random string (minimum 16 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Initial Administrator Setup (Optional - used during database seeding)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ems.local
ADMIN_NAME=System Administrator
# ADMIN_PASSWORD=your_secure_admin_password

# Application Preferences
ITEMS_PER_PAGE=10
CURRENCY_SYMBOL=$

