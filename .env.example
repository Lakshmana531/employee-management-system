# Database Configuration
# Local: localhost:3306 / employee_db
# Cloud (e.g., Aiven): mysql-xxxxx.aivencloud.com:12345 / defaultdb
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=employee_db

# SSL/TLS Configuration for Cloud Hosted Databases (Aiven, AWS RDS)
# Set DB_SSL_CA to the path of your CA certificate (e.g., ca.pem) if certificate verification is required
# DB_SSL_CA=/path/to/ca.pem
# Set to true only if connecting to an insecure local database without TLS
DB_SSL_DISABLED=false

# Flask Application Settings
# In production, SECRET_KEY must be a strong random string (minimum 16 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Initial Administrator Setup (Optional - used during database seeding)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ems.local
ADMIN_NAME=System Administrator
# ADMIN_PASSWORD=your_secure_admin_password

# Application Preferences
ITEMS_PER_PAGE=10
CURRENCY_SYMBOL=$

